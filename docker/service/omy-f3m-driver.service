# please copy this file to /etc/systemd/system/omy-f3m-driver@.service
# please replace %i with the instance name when enabling the service
[Unit]
Description=OMY F3M Follower Driver (%i) inside Docker humble_version
After=docker.service omy-container.service
Requires=docker.service omy-container.service

[Service]
Type=simple
EnvironmentFile=/etc/omy/f3m-driver-%i.env
SuccessExitStatus=143

ExecStartPre=/bin/bash -lc '/data/docker/humble/open_manipulator/docker/container.sh start'

ExecStart=/usr/bin/docker exec humble_version bash -lc '\
  export ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-42}; \
  export ROS_LOCALHOST_ONLY=${ROS_LOCALHOST_ONLY:-0}; \
  export RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION:-rmw_cyclonedds_cpp}; \
  source /opt/ros/humble/setup.bash && \
  source /root/ros2_ws/install/setup.bash && \
  ros2 launch open_manipulator_bringup omy_f3m_follower_ai.launch.py \
    namespace:=${NAMESPACE} \
    prefix:=${PREFIX} \
    publish_tf:=${PUBLISH_TF} \
'

ExecStop=/usr/bin/docker exec humble_version bash -lc '\
  pkill -2  -f "ros2 launch open_manipulator_bringup omy_f3m_follower_ai.launch.py" || true; \
  sleep 2; \
  pkill -15 -f "ros2 launch open_manipulator_bringup omy_f3m_follower_ai.launch.py" || true; \
  sleep 2; \
  pkill -9  -f "ros2 launch open_manipulator_bringup omy_f3m_follower_ai.launch.py" || true \
'

TimeoutStopSec=20
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
